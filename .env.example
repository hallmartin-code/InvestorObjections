# Copy to .env and fill in. Values here take precedence over machine-wide environment
# variables of the same name, so a stale global key can't silently shadow this file.
#
# Required. Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Web app only. When set, the site is gated behind HTTP Basic auth: any username,
# this password. Leave empty for an open deployment.
APP_PASSWORD=

# Archive copy of every completed run (web app AND CLI), sent via Resend.
# RESEND_API_KEY is the ONLY variable you must set — it switches the feature on.
# MAIL_FROM and RUN_COPY_TO are optional overrides; they default to
#   TEN Capital Deck Analyzer <deck-analyzer@tencapital.group>  ->  Info@tencapital.group
# MAIL_FROM must use a domain verified in your Resend dashboard.
# CLI runs can skip a single send with --no-email.
RESEND_API_KEY=
MAIL_FROM=Deck Analyzer <deck-analyzer@tencapital.group>
RUN_COPY_TO=

# Web app only. Optional tuning.
# JOB_TTL_SECONDS=3600
# WEB_MAX_WORKERS=2
